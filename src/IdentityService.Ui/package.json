{
  "name": "revora-identity-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000",
    "build": "npm run tokens:check && node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000",
    "lint": "node node_modules/eslint/bin/eslint.js . && node node_modules/stylelint/bin/stylelint.mjs \"**/*.css\"",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "tokens:generate": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "api:generate": "node scripts/generate-api-types.mjs",
    "api:check": "node scripts/generate-api-types.mjs --check",
    "test": "node node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "next": "^16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.13.0",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "yaml": "^2.8.0"
  },
  "overrides": {
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "js-yaml": "4.3.0"
  }
}
